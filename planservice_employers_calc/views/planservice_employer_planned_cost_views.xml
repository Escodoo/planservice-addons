<odoo>
    <record id="planservice_employer_planned_cost_view_list" model="ir.ui.view">
        <field name="name">planservice.employer.planned.cost.list</field>
        <field name="model">planservice.employer.planned.cost</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="project_id" />
                <field name="task_id" />
                <field name="task_name" optional="hide" />
                <field name="employee_id" />
                <field name="date" />
                <field name="date_start" optional="hide" />
                <field name="date_end" optional="hide" />
                <field name="allocated_hours" sum="Total" widget="float_time" />
                <field name="plan_monthly_hours" optional="hide" />
                <field name="currency_id" column_invisible="1" />
                <field name="monthly_cost" />
                <field name="planned_cost" sum="Total" />
                <field name="baseline_date" optional="hide" />
            </list>
        </field>
    </record>

    <record id="planservice_employer_planned_cost_view_pivot" model="ir.ui.view">
        <field name="name">planservice.employer.planned.cost.pivot</field>
        <field name="model">planservice.employer.planned.cost</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="project_id" type="row" />
                <field name="employee_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="planned_cost" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="planservice_employer_planned_cost_view_search" model="ir.ui.view">
        <field name="name">planservice.employer.planned.cost.search</field>
        <field name="model">planservice.employer.planned.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id" />
                <field name="task_id" />
                <field name="employee_id" />
                <group expand="0" string="Group by">
                    <filter
                        name="group_project"
                        string="Job site"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter
                        name="group_employee"
                        string="Team member"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="planservice_employer_planned_cost_action" model="ir.actions.act_window">
        <field name="name">Planned cost baseline</field>
        <field name="res_model">planservice.employer.planned.cost</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <menuitem
        id="planservice_employer_planned_cost_menu"
        name="Planned cost baseline"
        parent="hr_timesheet.menu_timesheets_reports"
        action="planservice_employer_planned_cost_action"
        groups="hr_timesheet.group_timesheet_manager"
        sequence="52"
    />
</odoo>
