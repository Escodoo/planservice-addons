<odoo>
    <record id="hr_employee_view_form_employer_cost" model="ir.ui.view">
        <field name="name">hr.employee.form.employer.cost</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_hourly_cost.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='hourly_cost']" position="after">
                <field name="employer_salary_benefits_cost" groups="hr.group_hr_user" />
                <!-- Igual a salário + benefícios: oculto para não repetir o valor -->
                <field
                    name="employer_monthly_total_cost"
                    groups="hr.group_hr_user"
                    invisible="1"
                />
            </xpath>
            <!-- O custo vem do salário + benefícios; o custo por hora não é usado -->
            <xpath expr="//label[@for='hourly_cost']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='hourly_cost']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="employer_cost_history"
                    string="Cost history"
                    groups="hr.group_hr_user"
                >
                    <field name="employer_cost_version_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="date_from" column_invisible="1" />
                            <field name="date_from_label" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="salary_benefits_cost" />
                            <field name="total_cost" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
