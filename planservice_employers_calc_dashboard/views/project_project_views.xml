<odoo>
    <record id="project_project_view_form_cost_dashboard" model="ir.ui.view">
        <field name="name">project.project.form.cost.dashboard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_cost_dashboard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bar-chart"
                    groups="hr_timesheet.group_timesheet_manager"
                    invisible="not id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Project cost</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
