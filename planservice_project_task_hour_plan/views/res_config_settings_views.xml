<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hour.plan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='project_time']" position="inside">
                <setting
                    id="hour_plan_monthly_hours_setting"
                    company_dependent="1"
                    help="Hours of one resource used as 100% capacity for each month in the task hour plan."
                >
                    <field
                        name="hour_plan_monthly_hours"
                        widget="timesheet_uom_no_toggle"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
