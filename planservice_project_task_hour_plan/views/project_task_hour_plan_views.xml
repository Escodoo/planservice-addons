<odoo>
    <record id="view_project_task_hour_plan_list" model="ir.ui.view">
        <field name="name">project.task.hour.plan.list</field>
        <field name="model">project.task.hour.plan</field>
        <field name="arch" type="xml">
            <list>
                <field
                    name="month"
                    widget="date"
                    options="{'min_precision': 'months', 'max_precision': 'months'}"
                />
                <field name="date_from" optional="hide" />
                <field name="date_to" optional="hide" />
                <field name="name" optional="hide" />
                <field name="project_id" />
                <field name="task_id" />
                <field name="capacity_percent" optional="show" />
                <field name="hours" widget="timesheet_uom_no_toggle" sum="Total" />
                <field
                    name="monthly_hours"
                    widget="timesheet_uom_no_toggle"
                    optional="hide"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_project_task_hour_plan_search" model="ir.ui.view">
        <field name="name">project.task.hour.plan.search</field>
        <field name="model">project.task.hour.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id" />
                <field name="project_id" />
                <field name="name" />
                <field name="month" />
                <field name="date_from" />
                <filter
                    string="This Year"
                    name="this_year"
                    domain="[('date_from', '&gt;=', context_today().strftime('%Y-01-01'))]"
                />
                <group>
                    <filter
                        string="Month"
                        name="group_month"
                        context="{'group_by': 'date_from:month'}"
                    />
                    <filter
                        string="Project"
                        name="group_project"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter
                        string="Task"
                        name="group_task"
                        context="{'group_by': 'task_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_project_task_hour_plan_pivot" model="ir.ui.view">
        <field name="name">project.task.hour.plan.pivot</field>
        <field name="model">project.task.hour.plan</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date_from" interval="month" type="row" />
                <field name="project_id" type="col" />
                <field name="hours" type="measure" widget="timesheet_uom" />
            </pivot>
        </field>
    </record>
    <record id="view_project_task_hour_plan_graph" model="ir.ui.view">
        <field name="name">project.task.hour.plan.graph</field>
        <field name="model">project.task.hour.plan</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="date_from" interval="month" />
                <field name="hours" type="measure" widget="timesheet_uom" />
            </graph>
        </field>
    </record>
    <record id="action_project_task_hour_plan" model="ir.actions.act_window">
        <field name="name">Task Hour Plans</field>
        <field name="res_model">project.task.hour.plan</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hour plan lines yet
            </p>
            <p>
                Set allocated hours and planned dates on a task to generate a
                monthly hour plan, or add months on the task to fill those
                fields from the plan.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_project_task_hour_plan"
        name="Task Hour Plans"
        parent="project.menu_project_report"
        action="action_project_task_hour_plan"
        sequence="20"
        groups="project.group_project_user"
    />
</odoo>
