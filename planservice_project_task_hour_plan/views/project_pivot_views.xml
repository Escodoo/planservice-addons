<odoo>
    <!-- Tarefas: o pivot não mostra tempo alocado em horas -->
    <record id="view_project_task_pivot_no_hours" model="ir.ui.view">
        <field name="name">project.task.pivot.no.hours</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_project_task_pivot" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="replace" />
        </field>
    </record>
</odoo>
