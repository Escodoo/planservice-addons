#. module: planservice_hr_timesheet_day_percentage
#. odoo-python
#: code:addons/planservice_hr_timesheet_day_percentage/models/account_analytic_line.py:0
msgid "Employee %(employee)s has no working hours defined on the calendar."
msgstr ""
"O funcionário %(employee)s não tem horas de trabalho definidas no "
"calendário."

#. module: planservice_hr_timesheet_day_percentage
#: model:ir.module.module,summary:base.module_planservice_hr_timesheet_day_percentage
msgid "Log timesheets as a percentage of the working day"
msgstr "Lançar timesheets como percentual do dia de trabalho"

#. module: planservice_hr_timesheet_day_percentage
#: model:ir.model.fields,help:planservice_hr_timesheet_day_percentage.field_account_analytic_line__day_percentage
msgid ""
"Percentage of the employee's working day. Updates Time Spent from the "
"resource calendar hours per day."
msgstr ""
"Percentual do dia de trabalho do funcionário. Atualiza o Tempo Gasto a "
"partir das horas por dia do calendário de recursos."

#. module: planservice_hr_timesheet_day_percentage
#: model:ir.module.module,shortdesc:base.module_planservice_hr_timesheet_day_percentage
msgid "Timesheet Day Percentage"
msgstr "Percentual do Dia no Timesheet"

#. module: planservice_hr_timesheet_day_percentage
#. odoo-python
#: code:addons/planservice_hr_timesheet_day_percentage/models/account_analytic_line.py:0
msgid ""
"You cannot log more than 100%% of the working day (%(hours_per_day).2f h). "
"%(employee)s would have %(used_percent).2f%% (%(used_hours).2f h) on "
"%(date)s."
msgstr ""
"Não é possível lançar mais de 100%% do dia de trabalho "
"(%(hours_per_day).2f h). %(employee)s teria %(used_percent).2f%% "
"(%(used_hours).2f h) em %(date)s."
