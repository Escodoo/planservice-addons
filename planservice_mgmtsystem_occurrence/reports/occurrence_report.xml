<odoo>
    <record id="paperformat_occurrence_record" model="report.paperformat">
        <field name="name">Occurrence Record</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record
        id="mgmtsystem_nonconformity.action_mgmtsystem_nonconformity_report"
        model="ir.actions.report"
    >
        <field name="name">Occurrence Record</field>
        <field name="print_report_name">'Occurrence Record - %s' % (object.ref)</field>
        <field
            name="paperformat_id"
            ref="planservice_mgmtsystem_occurrence.paperformat_occurrence_record"
        />
    </record>
</odoo>
