<odoo noupdate="1">
    <record id="tier_definition_occurrence_verification" model="tier.definition">
        <field name="name">Occurrence verification</field>
        <field
            name="model_id"
            ref="mgmtsystem_nonconformity.model_mgmtsystem_nonconformity"
        />
        <field name="review_type">field</field>
        <field
            name="reviewer_field_id"
            ref="planservice_mgmtsystem_occurrence.field_mgmtsystem_nonconformity__inspector_id"
        />
        <field name="definition_type">domain</field>
        <field name="definition_domain">[("state", "=", "waiting_verification")]</field>
        <field name="has_comment" eval="True" />
        <field name="notify_on_create" eval="True" />
        <field name="sequence">10</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="tier_definition_occurrence_concession" model="tier.definition">
        <field name="name">Occurrence concession</field>
        <field
            name="model_id"
            ref="mgmtsystem_nonconformity.model_mgmtsystem_nonconformity"
        />
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="mgmtsystem.group_mgmtsystem_manager" />
        <field name="definition_type">domain</field>
        <field
            name="definition_domain"
        >[("concession_required", "=", True), ("state", "=", "waiting_verification")]</field>
        <field name="has_comment" eval="True" />
        <field name="notify_on_create" eval="True" />
        <field name="sequence">20</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
