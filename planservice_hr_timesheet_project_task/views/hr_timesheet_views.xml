<odoo>
    <record id="hr_timesheet_line_tree_project_task" model="ir.ui.view">
        <field name="name">account.analytic.line.list.project.task</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute
                    name="context"
                >{'search_default_my_projects': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='unit_amount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="location_id" optional="show" />
                <field name="attachment_count" optional="show" />
                <button
                    name="%(action_timesheet_attachment_wizard)d"
                    type="action"
                    string="Attach"
                    icon="fa-paperclip"
                />
            </xpath>
        </field>
    </record>

    <record id="hr_timesheet_line_form_project_task" model="ir.ui.view">
        <field name="name">account.analytic.line.form.project.task</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute
                    name="context"
                >{'search_default_my_projects': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='unit_amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="location_id" />
                <field name="attachment_ids" widget="many2many_binary" />
            </xpath>
        </field>
    </record>

    <record id="hr_timesheet_line_kanban_project_task" model="ir.ui.view">
        <field name="name">account.analytic.line.kanban.project.task</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.view_kanban_account_analytic_line" />
        <field name="arch" type="xml">
            <xpath expr="//footer" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
