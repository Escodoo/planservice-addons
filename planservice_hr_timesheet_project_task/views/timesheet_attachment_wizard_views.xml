<odoo>
    <record id="view_timesheet_attachment_wizard_form" model="ir.ui.view">
        <field name="name">timesheet.attachment.wizard.form</field>
        <field name="model">timesheet.attachment.wizard</field>
        <field name="arch" type="xml">
            <form string="Attach Files">
                <group>
                    <field name="line_id" invisible="1" />
                    <field
                        name="attachment_ids"
                        widget="many2many_binary"
                        nolabel="1"
                    />
                </group>
                <footer>
                    <button
                        name="action_attach"
                        type="object"
                        string="Attach"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_timesheet_attachment_wizard" model="ir.actions.act_window">
        <field name="name">Attach Files</field>
        <field name="res_model">timesheet.attachment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_line_id': active_id}</field>
    </record>
</odoo>
