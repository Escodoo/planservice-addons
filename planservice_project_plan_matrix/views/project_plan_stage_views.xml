<odoo>
    <record id="view_project_plan_stage_tree" model="ir.ui.view">
        <field name="name">project.plan.stage.tree</field>
        <field name="model">project.plan.stage</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>
    <record id="action_project_plan_stage" model="ir.actions.act_window">
        <field name="name">Plan Stages</field>
        <field name="res_model">project.plan.stage</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="menu_project_plan_stage"
        name="Plan Stages"
        parent="project.menu_project_config"
        action="action_project_plan_stage"
        sequence="55"
        groups="project.group_project_manager"
    />
</odoo>
